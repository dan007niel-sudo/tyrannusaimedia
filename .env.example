# Tyrannus AI Media — Environment Variables
# Copy to .env and fill in your values.

# Google Gemini API Key (required)
# Must be from a Billing-Enabled Google Cloud Project for image generation.
GEMINI_API_KEY=your_gemini_api_key_here

# Admin token for project history reads and deletes (required for history panel)
HISTORY_ADMIN_TOKEN=change_this_to_a_long_random_secret

# Supabase persistence (required for project history and storage uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_server_key
